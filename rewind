#!/usr/bin/env python3
"""
rewind — instant replay buffer for Linux gamers.

Usage:
  rewind start       start the daemon (opens ui automatically)
  rewind stop        stop the daemon
  rewind clip        save a clip right now
  rewind status      show what's running
  rewind monitors    list available monitors
  rewind ui          open the web ui
  rewind --help
"""

import sys
import os

# Allow running directly from the source tree
_here = os.path.dirname(os.path.abspath(__file__))
if _here not in sys.path:
    sys.path.insert(0, _here)

# Also support installed location
_lib = os.path.join(os.path.expanduser('~'), '.local', 'lib', 'rewind')
if _lib not in sys.path:
    sys.path.insert(0, _lib)

import argparse


def main():
    p = argparse.ArgumentParser(
        prog='rewind',
        description='instant replay buffer for Linux',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument('--verbose', '-v', action='store_true', help='verbose logging')
    sub = p.add_subparsers(dest='cmd', metavar='command')

    sub.add_parser('start',    help='start the daemon')
    sub.add_parser('stop',     help='stop the daemon')
    sub.add_parser('clip',     help='save a clip right now')
    sub.add_parser('status',   help='show daemon status')
    sub.add_parser('monitors', help='list available monitors')
    sub.add_parser('ui',       help='open the web ui in a browser')

    args = p.parse_args()

    if args.cmd == 'start':
        from daemon import run_daemon
        run_daemon(verbose=args.verbose)

    elif args.cmd == 'stop':
        from daemon import cmd_stop
        cmd_stop()

    elif args.cmd == 'clip':
        from daemon import cmd_clip
        cmd_clip()

    elif args.cmd == 'status':
        from daemon import cmd_status
        cmd_status()

    elif args.cmd == 'monitors':
        from recorder import list_monitors, detect_backend
        try:
            backend = detect_backend()
        except RuntimeError as e:
            print(str(e))
            sys.exit(1)
        monitors = list_monitors(backend)
        if monitors:
            print(f'monitors ({backend}):')
            for m in monitors:
                print(f'  {m["id"]}   {m["label"]}')
        else:
            print('no monitors found')

    elif args.cmd == 'ui':
        import subprocess
        from config import load
        port = load().get('ui_port', 8855)
        subprocess.Popen(['xdg-open', f'http://127.0.0.1:{port}/'])

    else:
        p.print_help()


if __name__ == '__main__':
    main()
